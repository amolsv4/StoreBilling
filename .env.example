# Copy this file to .env and fill in real values. Never commit .env.
# This file must only ever contain placeholders — no real credentials.

# --- MySQL (used by docker-compose.yml) ---
MYSQL_DATABASE=storebilling
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Backend datasource (application-local.yml reads these) ---
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION_MS=1800000

# --- Bootstrap SUPER_ADMIN user ---
# Created once at startup only if no SUPER_ADMIN exists yet. Rotate/remove after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
